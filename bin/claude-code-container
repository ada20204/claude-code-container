#!/usr/bin/env bash
set -euo pipefail

app_name=claude-code-container
host_os="$(uname -s)"
image="${CLAUDE_CODE_CONTAINER_IMAGE:-claude-code-container:latest}"
home_volume="${CLAUDE_CODE_CONTAINER_HOME_VOLUME:-claude-code-container-home}"
host_work="${CLAUDE_CODE_CONTAINER_WORKSPACE:-$HOME/work}"
host_downloads="${CLAUDE_CODE_CONTAINER_DOWNLOADS:-$HOME/Downloads}"
host_documents="${CLAUDE_CODE_CONTAINER_DOCUMENTS:-$HOME/Documents}"
host_desktop="${CLAUDE_CODE_CONTAINER_DESKTOP:-$HOME/Desktop}"
host_claude_projects="${CLAUDE_CODE_CONTAINER_CLAUDE_PROJECTS:-$HOME/.claude/projects}"
extra_home_dirs="${CLAUDE_CODE_CONTAINER_EXTRA_HOME_DIRS:-}"
custom_mounts="${CLAUDE_CODE_CONTAINER_MOUNTS:-}"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
dockerfile="${CLAUDE_CODE_CONTAINER_DOCKERFILE:-$data_home/$app_name/Dockerfile}"
timezone="${CLAUDE_CODE_CONTAINER_TIMEZONE:-UTC}"
claude_version="${CLAUDE_CODE_CONTAINER_CLAUDE_VERSION:-latest}"
claude_binary="${CLAUDE_CODE_CONTAINER_CLAUDE_BINARY:-}"
build_network="${CLAUDE_CODE_CONTAINER_BUILD_NETWORK:-}"
base_image="${CLAUDE_CODE_CONTAINER_BASE_IMAGE:-}"
debian_mirror="${CLAUDE_CODE_CONTAINER_DEBIAN_MIRROR:-}"
debian_security_mirror="${CLAUDE_CODE_CONTAINER_DEBIAN_SECURITY_MIRROR:-}"
shell_alias=claude-container
case "$host_os" in
  Darwin) default_shell_rc="$HOME/.zshrc" ;;
  Linux) default_shell_rc="$HOME/.bashrc" ;;
  *) default_shell_rc="$HOME/.profile" ;;
esac
shell_rc="${CLAUDE_CODE_CONTAINER_SHELL_RC:-$default_shell_rc}"
host_user="$(id -un)"
if [[ "$host_os" == Darwin ]]; then
  container_uid=1000
  container_gid=1000
  container_home="/Users/$host_user"
else
  container_uid="$(id -u)"
  container_gid="$(id -g)"
  container_home="/home/$host_user"
fi
host_key_comment="claude-code-container:${home_volume}"
container_label="io.github.claude-code-container.home-volume=$home_volume"

usage() {
  cat <<'EOF'
Usage: claude-code-container <command> [ARG...]

Commands:
  install      Build and initialize the environment, then install the claude-container alias.
  reinstall    Rebuild and reinstall while preserving persistent Home data.
  uninstall    Remove runtime integration and image while preserving Home data.
  clear        Remove the runtime and all persistent Home data (requires confirmation).
  shell [--mount SPEC]          Enter the persistent Claude Code environment.
  run [--mount SPEC] -- COMMAND Run a command in a disposable container.
  doctor       Check prerequisites and current state.
  help         Show this help.

Mount syntax:
  --mount HOST_PATH:CONTAINER_PATH[:ro]
  Repeat --mount as needed. HOST_PATH must already exist.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

check_platform() {
  case "$host_os" in
    Linux) ;;
    Darwin)
      command -v orbctl >/dev/null 2>&1 || die 'macOS support requires OrbStack'
      [[ "$(orbctl status 2>/dev/null || true)" == Running ]] || die 'OrbStack is not running'
      ;;
    *) die "unsupported host platform: $host_os" ;;
  esac
  require_command docker
  docker info >/dev/null 2>&1 || die 'Docker daemon is unavailable to the current user'
}

build_image() {
  local target_image="${1:-$image}"
  local build_args=(build)
  local build_context build_status proxy_name proxy_value
  [[ -f "$dockerfile" ]] || die "Dockerfile does not exist: $dockerfile"
  if [[ -n "$claude_binary" ]]; then
    [[ "$claude_binary" == /* ]] || die 'CLAUDE_CODE_CONTAINER_CLAUDE_BINARY must be an absolute path'
    [[ -f "$claude_binary" && -x "$claude_binary" ]] || \
      die "Claude binary seed is not an executable file: $claude_binary"
  fi
  build_context="$(mktemp -d "${TMPDIR:-/tmp}/${app_name}.build.XXXXXX")" || \
    die 'could not create Docker build context'
  cp "$dockerfile" "$build_context/Dockerfile"
  : > "$build_context/claude-seed"
  if [[ -n "$claude_binary" ]]; then
    cp "$claude_binary" "$build_context/claude-seed"
    build_args+=(--build-arg 'CLAUDE_BINARY_SEED=1')
  fi
  if [[ -n "$build_network" ]]; then
    build_args+=(--network "$build_network")
  fi
  for proxy_name in http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY; do
    proxy_value="${!proxy_name:-}"
    [[ -n "$proxy_value" ]] && build_args+=(--build-arg "$proxy_name=$proxy_value")
  done
  [[ -n "$base_image" ]] && build_args+=(--build-arg "BASE_IMAGE=$base_image")
  [[ -n "$debian_mirror" ]] && build_args+=(--build-arg "DEBIAN_MIRROR=$debian_mirror")
  [[ -n "$debian_security_mirror" ]] && build_args+=(--build-arg "DEBIAN_SECURITY_MIRROR=$debian_security_mirror")
  if docker "${build_args[@]}" \
    --build-arg "DEV_USER=$host_user" \
    --build-arg "DEV_UID=$container_uid" \
    --build-arg "DEV_GID=$container_gid" \
    --build-arg "DEV_HOME=$container_home" \
    --build-arg "DEV_TZ=$timezone" \
    --build-arg "TARGET_CLAUDE_VERSION=$claude_version" \
    --tag "$target_image" \
    --file "$build_context/Dockerfile" \
    "$build_context"; then
    build_status=0
  else
    build_status=$?
  fi
  rm -rf "$build_context"
  return "$build_status"
}

require_workspace() {
  local path
  for path in "$host_work" "$host_downloads" "$host_documents" "$host_desktop" "$host_claude_projects"; do
    [[ -d "$path" ]] || die "required host directory does not exist: $path"
  done
}

bridge_subnet() {
  local subnet
  subnet="$(docker network inspect bridge --format '{{(index .IPAM.Config 0).Subnet}}')"
  [[ "$subnet" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$ ]] || \
    die "unexpected Docker bridge subnet: $subnet"
  printf '%s\n' "$subnet"
}

host_authorized_source() {
  if [[ "$host_os" == Darwin ]]; then
    printf '%s\n' '127.0.0.1/32'
  else
    bridge_subnet
  fi
}

initialize_home() {
  docker run --rm --interactive \
    --volume "$home_volume:$container_home" \
    "$image" bash -s -- "$host_user" "$host_key_comment" <<'CONTAINER_INIT'
set -euo pipefail

host_user="$1"
key_comment="$2"
key="$HOME/.ssh/id_ed25519_host"
config="$HOME/.ssh/config"

install -d -m 700 "$HOME/.ssh" "$HOME/.claude"
zshrc="$HOME/.zshrc"
if [[ ! -e "$zshrc" ]]; then
  cat > "$zshrc" <<'EOF'
export ZSH=/usr/local/share/oh-my-zsh
ZSH_THEME="robbyrussell"
plugins=(git)
source "$ZSH/oh-my-zsh.sh"
EOF
  chmod 600 "$zshrc"
fi
claude_link="$HOME/.local/bin/claude"
if [[ -L "$claude_link" ]]; then
  claude_target="$(readlink "$claude_link")"
  case "$claude_target" in
    "/home/$host_user/.local/share/claude/versions/"*)
      claude_version="${claude_target##*/}"
      migrated_target="$HOME/.local/share/claude/versions/$claude_version"
      [[ -x "$migrated_target" ]] || {
        printf 'Missing persisted Claude binary: %s\n' "$migrated_target" >&2
        exit 1
      }
      ln -sfn "$migrated_target" "$claude_link"
      ;;
  esac
fi
if [[ ! -f "$key" ]]; then
  ssh-keygen -q -t ed25519 -N '' -C "$key_comment" -f "$key"
fi
if [[ "$(awk '{print $3}' "$key.pub")" != "$key_comment" ]]; then
  ssh-keygen -q -c -C "$key_comment" -P '' -f "$key" >/dev/null
fi

python3 - "$config" "$host_user" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
host_user = sys.argv[2]
start = "# claude-code-container: host access begin"
end = "# claude-code-container: host access end"
text = path.read_text() if path.exists() else ""
if start in text or end in text:
    before, separator, remainder = text.partition(start)
    if not separator or end not in remainder:
        raise SystemExit(f"Malformed claude-code-container block in {path}")
    _, _, after = remainder.partition(end)
    text = (before.rstrip() + "\n" + after.lstrip()).strip()
for line in text.splitlines():
    if line.strip().split() == ["Host", "host"]:
        raise SystemExit(f"Conflicting Host host entry in {path}")

block = f"""{start}
Host host
    HostName host.docker.internal
    User {host_user}
    IdentityFile ~/.ssh/id_ed25519_host
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
{end}"""
path.write_text((text.rstrip() + "\n\n" if text else "") + block + "\n")
PY

if [[ -L "$HOME/work" ]]; then
  [[ "$(readlink "$HOME/work")" == /workspace ]] || {
    printf 'Conflicting symlink: %s -> %s\n' "$HOME/work" "$(readlink "$HOME/work")" >&2
    exit 1
  }
elif [[ -e "$HOME/work" ]]; then
  printf 'Conflicting path already exists: %s\n' "$HOME/work" >&2
  exit 1
else
  ln -s /workspace "$HOME/work"
fi
if [[ ! -f "$HOME/.claude/CLAUDE.md" ]]; then
  cat > "$HOME/.claude/CLAUDE.md" <<EOF
# Claude Code Development Container

## Environment

- Home and default directory: \`$HOME\`.
- Host workspace: \`$HOME/work\`, linked to \`/workspace\`.
- Home data persists in a Docker volume; other container paths are disposable.
- Use \`ssh host\` for restricted, key-based access to the Docker host.

## Operating Rules

1. Keep project work under \`~/work\` or \`/workspace\`.
2. Install user-level tools under \`~/.local\` so they persist.
3. Never copy host private keys into the container.
EOF
  chmod 600 "$HOME/.claude/CLAUDE.md"
elif grep -Fqx -- "- Home and default directory: \`/home/$host_user\`." "$HOME/.claude/CLAUDE.md"; then
  python3 - "$HOME/.claude/CLAUDE.md" "$host_user" "$HOME" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
old = f"- Home and default directory: `/home/{sys.argv[2]}`."
new = f"- Home and default directory: `{sys.argv[3]}`."
path.write_text(path.read_text().replace(old, new))
PY
fi

chmod 600 "$config" "$key"
chmod 644 "$key.pub"
cat "$key.pub"
CONTAINER_INIT
}

install_host_authorization() {
  local subnet public_key authorized_line stage backup
  subnet="$(host_authorized_source)"
  public_key="$(initialize_home)"
  [[ "$public_key" == 'ssh-ed25519 '* ]] || die 'container public key has an unexpected format'

  install -d -m 700 "$HOME/.ssh"
  touch "$HOME/.ssh/authorized_keys"
  chmod 600 "$HOME/.ssh/authorized_keys"
  authorized_line="from=\"$subnet\",no-agent-forwarding,no-port-forwarding,no-X11-forwarding,no-user-rc $public_key"
  if ! grep -Fqx "$authorized_line" "$HOME/.ssh/authorized_keys"; then
    backup="$HOME/.ssh/authorized_keys.backup-before-$app_name-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    cp -p "$HOME/.ssh/authorized_keys" "$backup"
    stage="$(mktemp "$HOME/.ssh/authorized_keys.$app_name.XXXXXX")"
    trap 'rm -f "$stage"' EXIT
    awk -v comment="$host_key_comment" '$NF != comment' "$HOME/.ssh/authorized_keys" > "$stage"
    printf '%s\n' "$authorized_line" >> "$stage"
    chmod 600 "$stage"
    mv "$stage" "$HOME/.ssh/authorized_keys"
    trap - EXIT
  fi
}

initialize_runtime() {
  require_workspace
  docker image inspect "$image" >/dev/null 2>&1 || \
    die "Docker image does not exist: $image; run claude-code-container install"
  if ! docker volume inspect "$home_volume" >/dev/null 2>&1; then
    docker volume create \
      --label io.github.claude-code-container.purpose=persistent-home \
      "$home_volume" >/dev/null
  fi
  install_host_authorization
  verify_host_ssh
}

verify_host_ssh() {
  docker run --rm \
    --add-host host.docker.internal:host-gateway \
    --volume "$home_volume:$container_home" \
    "$image" ssh -o BatchMode=yes -o ConnectTimeout=8 host true || \
    die 'container-to-host SSH verification failed; confirm that the host SSH server is reachable'
}

install_alias() {
  local start='# claude-code-container: shell alias begin'
  local end='# claude-code-container: shell alias end'
  touch "$shell_rc"
  python3 - "$shell_rc" "$start" "$end" "$shell_alias" "$extra_home_dirs" "$custom_mounts" <<'PY'
from pathlib import Path
import shlex
import sys

path = Path(sys.argv[1])
start, end, alias_name, extra_home_dirs, custom_mounts = sys.argv[2:]
text = path.read_text()
if start in text or end in text:
    before, separator, remainder = text.partition(start)
    if not separator or end not in remainder:
        raise SystemExit(f"Malformed claude-code-container alias block in {path}")
    _, _, after = remainder.partition(end)
    text = (before.rstrip() + "\n" + after.lstrip()).strip()
for line in text.splitlines():
    if line.strip().startswith(f"alias {alias_name}="):
        raise SystemExit(f"Conflicting alias {alias_name} in {path}")
lines = [start]
if extra_home_dirs:
    lines.append(
        "export CLAUDE_CODE_CONTAINER_EXTRA_HOME_DIRS=" + shlex.quote(extra_home_dirs)
    )
if custom_mounts:
    lines.append(
        "export CLAUDE_CODE_CONTAINER_MOUNTS=" + shlex.quote(custom_mounts)
    )
lines.extend([f"alias {alias_name}='claude-code-container shell'", end])
block = "\n".join(lines)
path.write_text((text.rstrip() + "\n\n" if text else "") + block + "\n")
PY
}

remove_alias() {
  local start='# claude-code-container: shell alias begin'
  local end='# claude-code-container: shell alias end'
  [[ -f "$shell_rc" ]] || return 0
  python3 - "$shell_rc" "$start" "$end" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
start, end = sys.argv[2:]
text = path.read_text()
if start not in text and end not in text:
    raise SystemExit(0)
before, separator, remainder = text.partition(start)
if not separator or end not in remainder:
    raise SystemExit(f"Malformed claude-code-container alias block in {path}")
_, _, after = remainder.partition(end)
text = (before.rstrip() + "\n" + after.lstrip()).rstrip()
path.write_text(text + ("\n" if text else ""))
PY
}

remove_host_authorization() {
  local file stage backup
  file="$HOME/.ssh/authorized_keys"
  [[ -f "$file" ]] || return 0
  if awk -v comment="$host_key_comment" '$NF == comment { found=1 } END { exit !found }' "$file"; then
    backup="$file.backup-before-$app_name-uninstall-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    cp -p "$file" "$backup"
    stage="$(mktemp "$file.$app_name.XXXXXX")"
    trap 'rm -f "$stage"' EXIT
    awk -v comment="$host_key_comment" '$NF != comment' "$file" > "$stage"
    chmod 600 "$stage"
    mv "$stage" "$file"
    trap - EXIT
  fi
}

remove_runtime() {
  local container_id
  while IFS= read -r container_id; do
    [[ -n "$container_id" ]] && docker rm -f "$container_id" >/dev/null
  done < <(docker ps -aq --filter "label=$container_label")
  docker image inspect "$image" >/dev/null 2>&1 && docker image rm "$image" >/dev/null
  remove_alias
  remove_host_authorization
}

confirm_clear() {
  [[ "${1:-}" == --yes ]] && return 0
  if [[ ! -t 0 ]]; then
    die "clear permanently removes $home_volume; rerun with --yes"
  fi
  local answer
  printf 'Permanently remove volume %s and all Claude login/configuration data? [y/N] ' "$home_volume" >&2
  read -r answer
  [[ "$answer" =~ ^[yY]$ ]] || { printf 'Clear cancelled.\n'; exit 0; }
}

append_custom_mount() {
  local spec="$1"
  local mode=rw
  local mapping source target
  case "$spec" in
    *:ro) mode=ro; mapping="${spec%:ro}" ;;
    *:rw) mapping="${spec%:rw}" ;;
    *) mapping="$spec" ;;
  esac
  source="${mapping%%:*}"
  target="${mapping#*:}"
  [[ -n "$source" && "$target" != "$mapping" && -n "$target" ]] || \
    die "invalid mount specification: $spec"
  case "$source" in
    \~) source="$HOME" ;;
    \~/*) source="$HOME/${source#\~/}" ;;
  esac
  [[ "$source" != *:* ]] || die "mount source cannot contain a colon: $source"
  [[ -e "$source" ]] || die "mount source does not exist: $source"
  [[ "$source" == /* ]] || source="$PWD/$source"
  case "$target" in
    /*) ;;
    *) die "mount target must be an absolute container path: $target" ;;
  esac
  case "$target" in
    *:*|*//*|*/./*|*/.|*/../*|*/..) die "mount target must be a normalized path: $target" ;;
  esac
  case "$target" in
    /|/workspace|"$container_home"|"$container_home/Downloads"|"$container_home/Documents"|"$container_home/Desktop"|"$container_home/.claude/projects")
      die "mount target is managed by claude-code-container: $target"
      ;;
  esac
  custom_run_args+=(--volume "$source:$target:$mode")
}

parse_mount_options() {
  command_args=()
  cli_mount_specs=()
  while (($#)); do
    case "$1" in
      --mount)
        (($# >= 2)) || die '--mount requires HOST_PATH:CONTAINER_PATH[:ro]'
        cli_mount_specs+=("$2")
        shift 2
        ;;
      --mount=*)
        cli_mount_specs+=("${1#--mount=}")
        shift
        ;;
      --)
        shift
        break
        ;;
      *) break ;;
    esac
  done
  command_args=("$@")
}

run_container() {
  local run_args=(run --rm)
  local extra_dir
  local extra_dirs=()
  local env_mount
  local env_mount_specs=()
  custom_run_args=()
  [[ -t 0 && -t 1 ]] && run_args+=(-it)
  if [[ -n "$extra_home_dirs" ]]; then
    IFS=',' read -r -a extra_dirs <<< "$extra_home_dirs"
    for extra_dir in "${extra_dirs[@]}"; do
      case "$extra_dir" in
        ''|.|..|*/*|*[^a-zA-Z0-9._-]*) die "invalid extra Home directory name: $extra_dir" ;;
      esac
      [[ -d "$HOME/$extra_dir" ]] || die "extra host directory does not exist: $HOME/$extra_dir"
      run_args+=(--volume "$HOME/$extra_dir:$container_home/$extra_dir")
    done
  fi
  if [[ -n "$custom_mounts" ]]; then
    IFS=';' read -r -a env_mount_specs <<< "$custom_mounts"
    for env_mount in "${env_mount_specs[@]}"; do
      [[ -n "$env_mount" ]] || die 'CLAUDE_CODE_CONTAINER_MOUNTS contains an empty entry'
      append_custom_mount "$env_mount"
    done
  fi
  if ((${#cli_mount_specs[@]})); then
    for env_mount in "${cli_mount_specs[@]}"; do
      append_custom_mount "$env_mount"
    done
  fi
  if ((${#custom_run_args[@]})); then
    run_args+=("${custom_run_args[@]}")
  fi
  exec docker "${run_args[@]}" \
    --label "$container_label" \
    --add-host host.docker.internal:host-gateway \
    --workdir "$container_home" \
    --volume "$home_volume:$container_home" \
    --volume "$host_work:/workspace" \
    --volume "$host_downloads:$container_home/Downloads" \
    --volume "$host_documents:$container_home/Documents" \
    --volume "$host_desktop:$container_home/Desktop" \
    --volume "$host_claude_projects:$container_home/.claude/projects" \
    "$image" "$@"
}

doctor() {
  check_platform
  printf 'Host platform: %s\n' "$host_os"
  printf 'Container Home: %s\n' "$container_home"
  printf 'Docker: ok\n'
  printf 'Dockerfile: %s\n' "$dockerfile"
  printf 'Workspace: %s\n' "$host_work"
  printf 'Downloads: %s\n' "$host_downloads"
  printf 'Documents: %s\n' "$host_documents"
  printf 'Desktop: %s\n' "$host_desktop"
  printf 'Claude projects: %s\n' "$host_claude_projects"
  printf 'Extra Home directories: %s\n' "${extra_home_dirs:-none}"
  printf 'Custom mounts: %s\n' "${custom_mounts:-none}"
  printf 'Claude binary seed: %s\n' "${claude_binary:-none}"
  printf 'Build network: %s\n' "${build_network:-default}"
  printf 'Base image: %s\n' "${base_image:-Dockerfile default}"
  docker image inspect "$image" >/dev/null 2>&1 && printf 'Image: present (%s)\n' "$image" || printf 'Image: absent (%s)\n' "$image"
  docker volume inspect "$home_volume" >/dev/null 2>&1 && printf 'Home volume: present (%s)\n' "$home_volume" || printf 'Home volume: absent (%s)\n' "$home_volume"
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
  install)
    check_platform
    build_image
    initialize_runtime
    install_alias
    printf 'Installed. Reload your shell, then run: %s\n' "$shell_alias"
    ;;
  reinstall)
    check_platform
    temporary_image="${image}-reinstall-$$"
    trap 'docker image rm "$temporary_image" >/dev/null 2>&1 || true' EXIT
    build_image "$temporary_image"
    remove_runtime
    docker tag "$temporary_image" "$image"
    docker image rm "$temporary_image" >/dev/null
    trap - EXIT
    initialize_runtime
    install_alias
    printf 'Reinstalled. Persistent Home data was preserved.\n'
    ;;
  uninstall)
    (($# == 0)) || die 'uninstall does not accept arguments'
    check_platform
    remove_runtime
    printf 'Uninstalled. Persistent Home volume preserved: %s\n' "$home_volume"
    ;;
  clear)
    (($# <= 1)) || die 'usage: claude-code-container clear [--yes]'
    [[ $# == 0 || "$1" == --yes ]] || die 'usage: claude-code-container clear [--yes]'
    check_platform
    confirm_clear "${1:-}"
    remove_runtime
    docker volume inspect "$home_volume" >/dev/null 2>&1 && docker volume rm "$home_volume" >/dev/null
    printf 'Cleared image, Home data, alias, host authorization, and related containers.\n'
    ;;
  shell)
    parse_mount_options "$@"
    ((${#command_args[@]} == 0)) || die 'usage: claude-code-container shell [--mount SPEC]'
    check_platform
    initialize_runtime
    run_container zsh
    ;;
  run)
    parse_mount_options "$@"
    ((${#command_args[@]})) || die 'run requires a command'
    check_platform
    initialize_runtime
    run_container "${command_args[@]}"
    ;;
  doctor)
    (($# == 0)) || die 'doctor does not accept arguments'
    doctor
    ;;
  help|--help|-h)
    usage
    ;;
    *)
      printf 'error: unknown command: %s\n' "$command" >&2
      usage >&2
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
